<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>NIFTY Live Intelligence – Chart Lab (demo)</title>
<style>
:root{--bg:#0a0f16;--p:#111925;--b:#202c3b;--t:#dbe4ee;--m:#7c8ba0;--g:#26c281;--r:#ef5350;--a:#f0b429;--bl:#5aa9ff}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--t);font:13px/1.45 system-ui,Segoe UI,Roboto,sans-serif}
header{display:flex;flex-wrap:wrap;gap:10px;align-items:center;padding:10px 16px;border-bottom:1px solid var(--b)}
h1{font-size:16px;margin:0 auto 0 0}h1 small{color:var(--m);font-weight:400;margin-left:8px}
.badge{background:#3a2e0b;color:var(--a);border:1px solid #6b5416;padding:3px 9px;border-radius:5px;font-weight:600}
.badge.csv{background:#0d2b3f;color:var(--bl);border-color:#1f5a82}
main{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:12px;padding:12px 16px}
@media(max-width:980px){main{grid-template-columns:1fr}}
.panel{background:var(--p);border:1px solid var(--b);border-radius:8px;padding:10px;min-width:0}
.bar{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin-bottom:8px}
button,label.btn{background:#16212f;color:var(--t);border:1px solid var(--b);border-radius:5px;padding:5px 10px;cursor:pointer;font:inherit}
button.on{background:#1d3a5c;border-color:var(--bl);color:#fff}button:focus-visible,label.btn:focus-within{outline:2px solid var(--bl)}
.sp{margin-left:auto;color:var(--m)}
#wrap{position:relative}canvas{width:100%;height:480px;display:block;touch-action:none;cursor:crosshair}
#tip{position:absolute;top:6px;left:8px;pointer-events:none;color:var(--m);font:12px ui-monospace,Consolas,monospace}
h2{font-size:13px;margin:0 0 6px}table{width:100%;border-collapse:collapse;font-size:12px}
td,th{padding:3px 4px;border-bottom:1px solid var(--b);text-align:right}th{color:var(--m);font-weight:500}td:first-child,th:first-child{text-align:left}
.g{color:var(--g)}.r{color:var(--r)}.m{color:var(--m)}.note{color:var(--m);font-size:11px;margin-top:6px}
.stack{display:flex;flex-direction:column;gap:12px}
</style></head><body>
<header><h1>NIFTY Live Intelligence<small>Chart Lab</small></h1>
<span class="badge" id="badge">DEMO DATA – not market prices</span>
<label class="btn">Load CSV<input id="csv" type="file" accept=".csv" hidden></label></header>
<main><div class="stack">
<section class="panel"><div class="bar" id="tfs"></div>
<div class="bar" id="ovs"></div>
<div id="wrap"><canvas id="cv"></canvas><div id="tip"></div></div>
<div class="note">Wheel = zoom, drag = pan. Levels and patterns are technical estimates from past candles, not predictions or advice. No orders are ever placed.</div></section>
<section class="panel"><h2>Multi-timeframe</h2><table id="mtf"></table><div class="note">Trend = EMA20 vs EMA50. Time = last completed candle (IST).</div></section></div>
<div class="stack">
<section class="panel"><h2>Support &amp; resistance (estimates)</h2><table id="lv"></table></section>
<section class="panel"><h2>Patterns (this timeframe)</h2><table id="pt"></table><div class="note">“Developing” = not confirmed yet. Confirmed only after a candle close beyond the neckline.</div></section>
<section class="panel"><h2>CSV format</h2><div class="note">1-minute candles, one per line: <code>timestamp,open,high,low,close,volume</code>. Timestamp like <code>2026-10-16T09:15:00+05:30</code>. Rows outside 09:15–15:30 IST are ignored. Without a CSV the page shows generated demo data.</div></section></div></main>
<script>
// ===CORE===
const IST=19800000,TF={'1m':1,'5m':5,'10m':10,'15m':15,'1h':60,'1D':375};
const rng=s=>()=>(s=(s*1664525+1013904223)>>>0)/4294967296;
function demo(){const r=rng(7),o=[];let p=25100;
 for(let d=0;d<5;d++){const day=Date.UTC(2026,9,12+d,9,15)-IST;
  for(let m=0;m<375;m++){const op=p;p+=(r()-.5)*9+Math.sin((d*375+m)/60)*1.4;
   o.push({t:day+m*6e4,o:op,h:Math.max(op,p)+r()*3,l:Math.min(op,p)-r()*3,c:p,v:Math.round(800+r()*1200)})}}return o}
function agg(c,n){const mp=new Map();
 for(const k of c){const s=new Date(k.t+IST),mins=s.getUTCHours()*60+s.getUTCMinutes()-555;if(mins<0||mins>=375)continue;
  const dayU=Date.UTC(s.getUTCFullYear(),s.getUTCMonth(),s.getUTCDate()),b=Math.floor(mins/n),key=dayU+'-'+b,x=mp.get(key);
  if(!x)mp.set(key,{t:dayU+(555+b*n)*6e4-IST,day:dayU,o:k.o,h:k.h,l:k.l,c:k.c,v:k.v});
  else{x.h=Math.max(x.h,k.h);x.l=Math.min(x.l,k.l);x.c=k.c;x.v+=k.v}}
 return [...mp.values()].sort((a,b)=>a.t-b.t)}
const sma=(x,n)=>x.map((_,i)=>i+1<n?null:x.slice(i+1-n,i+1).reduce((a,b)=>a+b,0)/n);
function ema(x,n){const k=2/(n+1);let p=null;return x.map((v,i)=>{if(i+1<n)return null;p=p===null?x.slice(0,n).reduce((a,b)=>a+b,0)/n:v*k+p*(1-k);return p})}
function rsi(c,n=14){const o=Array(c.length).fill(null);if(c.length<=n)return o;let ag=0,al=0;
 for(let i=1;i<=n;i++){const d=c[i]-c[i-1];ag+=Math.max(d,0);al+=Math.max(-d,0)}ag/=n;al/=n;
 const f=()=>al===0?100:100-100/(1+ag/al);o[n]=f();
 for(let i=n+1;i<c.length;i++){const d=c[i]-c[i-1];ag=(ag*(n-1)+Math.max(d,0))/n;al=(al*(n-1)+Math.max(-d,0))/n;o[i]=f()}return o}
function boll(c,n=20,k=2){const m=sma(c,n);return m.map((v,i)=>{if(v===null)return null;const sd=Math.sqrt(c.slice(i+1-n,i+1).reduce((a,b)=>a+(b-v)**2,0)/n);return[v-k*sd,v,v+k*sd]})}
function vwap(c){let d=null,pv=0,vv=0;return c.map(k=>{if(k.day!==d){d=k.day;pv=0;vv=0}pv+=(k.h+k.l+k.c)/3*k.v;vv+=k.v;return vv?pv/vv:null})}
function swings(h,l,k=3){const r=[];for(let i=k;i<h.length-k;i++){
 const H=h.slice(i-k,i+k+1),L=l.slice(i-k,i+k+1);
 if(h[i]===Math.max(...H)&&h[i]>Math.max(...h.slice(i-k,i)))r.push({conf:i+k,kind:'high',p:h[i],i});
 if(l[i]===Math.min(...L)&&l[i]<Math.min(...l.slice(i-k,i)))r.push({conf:i+k,kind:'low',p:l[i],i})}return r}
function mergeLv(items,tol=.15){const cl=[];for(const it of [...items].sort((a,b)=>a.p-b.p)){const c=cl[cl.length-1];
 if(c&&Math.abs(it.p-c.at(-1).p)/c.at(-1).p*100<=tol)c.push(it);else cl.push([it])}
 return cl.map(c=>({p:c.reduce((a,b)=>a+b.p,0)/c.length,n:c.length,src:[...new Set(c.map(x=>x.src))].join('/')})).sort((a,b)=>b.n-a.n)}
function levels(c){if(c.length<10)return[];const h=c.map(k=>k.h),l=c.map(k=>k.l),cmp=c.at(-1).c,items=[];
 for(const s of swings(h,l))items.push({p:s.p,src:'swing'});
 const days=[...new Set(c.map(k=>k.day))],cur=c.filter(k=>k.day===days.at(-1));
 items.push({p:Math.max(...cur.map(k=>k.h)),src:'day high'},{p:Math.min(...cur.map(k=>k.l)),src:'day low'});
 if(days.length>1){const pv=c.filter(k=>k.day===days.at(-2));items.push({p:Math.max(...pv.map(k=>k.h)),src:'prev high'},{p:Math.min(...pv.map(k=>k.l)),src:'prev low'});
  const P=(Math.max(...pv.map(k=>k.h))+Math.min(...pv.map(k=>k.l))+pv.at(-1).c)/3;items.push({p:P,src:'pivot'})}
 return mergeLv(items).slice(0,8).map(x=>({...x,side:x.p<cmp?'S':'R',dist:(x.p-cmp)/cmp*100})).sort((a,b)=>b.p-a.p)}
function dbl(c,top,k=3,tol=.3){const h=c.map(x=>x.h),l=c.map(x=>x.l),cl=c.map(x=>x.c),sw=swings(h,l,k);
 const A=sw.filter(s=>s.kind===(top?'high':'low')),B=sw.filter(s=>s.kind===(top?'low':'high'));if(A.length<2)return null;
 const a=A.at(-2),b=A.at(-1);if(Math.abs(a.p-b.p)/a.p*100>tol)return null;
 const mid=B.filter(x=>x.i>a.i&&x.i<b.i);if(!mid.length)return null;
 const neck=top?Math.min(...mid.map(x=>x.p)):Math.max(...mid.map(x=>x.p));
 const ok=cl.slice(b.conf).some(v=>top?v<neck:v>neck);
 return{name:top?'Double top':'Double bottom',status:ok?'confirmed':'developing',neck,inval:top?Math.max(a.p,b.p):Math.min(a.p,b.p),cond:(top?'close below ':'close above ')+neck.toFixed(1)}}
function candlePat(c){const i=c.length-1;if(i<0)return null;const k=c[i],body=Math.abs(k.c-k.o),rg=k.h-k.l;if(rg<=0)return null;
 if(body<=.1*rg)return'Doji';const up=k.h-Math.max(k.o,k.c),lo=Math.min(k.o,k.c)-k.l;
 if(lo>=2*body&&up<=.3*body)return'Hammer';if(up>=2*body&&lo<=.3*body)return'Shooting star';
 if(i>0){const p=c[i-1];if(p.c<p.o&&k.c>k.o&&k.o<=p.c&&k.c>=p.o)return'Bullish engulfing';if(p.c>p.o&&k.c<k.o&&k.o>=p.c&&k.c<=p.o)return'Bearish engulfing'}return null}
// ===UI===
const $=id=>document.getElementById(id),fmt=n=>n==null?'N/A':n.toLocaleString('en-IN',{maximumFractionDigits:2,minimumFractionDigits:2});
const tsf=t=>new Date(t).toLocaleString('en-IN',{timeZone:'Asia/Kolkata',day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit',hour12:false});
let raw=demo(),tf='5m',ov={EMA9:1,EMA20:1,EMA50:0,VWAP:1,BB:0,Levels:1},C=[],ind={},view={s:0,n:80},mx=null;
function compute(){C=agg(raw,TF[tf]);const cl=C.map(k=>k.c);
 ind={e9:ema(cl,9),e20:ema(cl,20),e50:ema(cl,50),vw:vwap(C),bb:boll(cl),rsi:rsi(cl),lv:levels(C)};
 view.n=Math.min(Math.max(20,view.n),Math.max(20,C.length));view.s=Math.max(0,C.length-view.n)}
function ui(){$('tfs').innerHTML=Object.keys(TF).map(k=>`<button class="${k===tf?'on':''}" data-tf="${k}">${k}</button>`).join('')+`<span class="sp">${C.length} candles · last completed ${C.length?tsf(C.at(-1).t):'N/A'} IST</span>`;
 $('ovs').innerHTML=Object.keys(ov).map(k=>`<button class="${ov[k]?'on':''}" data-ov="${k}">${k}</button>`).join('');
 $('lv').innerHTML='<tr><th>Level</th><th>Type</th><th>Touches</th><th>vs CMP</th></tr>'+ind.lv.map(x=>`<tr><td>${fmt(x.p)}</td><td class="${x.side==='S'?'g':'r'}">${x.side==='S'?'Support':'Resist.'} <span class="m">${x.src}</span></td><td>${x.n}</td><td>${x.dist>0?'+':''}${x.dist.toFixed(2)}%</td></tr>`).join('');
 const ps=[dbl(C,true),dbl(C,false)].filter(Boolean),cp=candlePat(C);
 $('pt').innerHTML=(ps.length||cp?'':'<tr><td class="m">No pattern detected</td></tr>')+ps.map(p=>`<tr><td>${p.name}</td><td class="${p.status==='confirmed'?'g':'m'}">${p.status}</td><td>${p.cond}; invalid ${p.inval>p.neck?'above':'below'} ${fmt(p.inval)}</td></tr>`).join('')+(cp?`<tr><td>${cp}</td><td class="m">last candle</td><td></td></tr>`:'');
 $('mtf').innerHTML='<tr><th>TF</th><th>Trend</th><th>RSI</th><th>Last candle</th><th>Time</th></tr>'+Object.keys(TF).map(k=>{const c=agg(raw,TF[k]),cl=c.map(x=>x.c),a=ema(cl,20).at(-1),b=ema(cl,50).at(-1),r=rsi(cl).at(-1),tr=a==null||b==null?null:a>b;
  return`<tr><td>${k}</td><td class="${tr==null?'m':tr?'g':'r'}">${tr==null?'N/A':tr?'Up':'Down'}</td><td>${r==null?'N/A':r.toFixed(0)}</td><td>${candlePat(c)||'–'}</td><td class="m">${c.length?tsf(c.at(-1).t):'N/A'}</td></tr>`}).join('')}
function draw(){const cv=$('cv'),dpr=devicePixelRatio||1,W=cv.clientWidth,H=cv.clientHeight;cv.width=W*dpr;cv.height=H*dpr;const x=cv.getContext('2d');x.scale(dpr,dpr);x.clearRect(0,0,W,H);
 const V=C.slice(view.s,view.s+view.n);if(!V.length){x.fillStyle='#7c8ba0';x.fillText('No candles for this timeframe',20,30);return}
 const L=8,R=64,pw=W-L-R,ph=H*.66,vy=ph+8,vh=H*.12,ry=vy+vh+16,rh=H-ry-14,cw=pw/V.length,X=i=>L+(i+.5)*cw;
 const lo=Math.min(...V.map(k=>k.l)),hi=Math.max(...V.map(k=>k.h)),pad=(hi-lo)*.06||1,Y=p=>6+(hi+pad-p)/(hi-lo+2*pad)*(ph-6);
 x.font='11px ui-monospace,Consolas,monospace';x.strokeStyle='#202c3b';x.fillStyle='#7c8ba0';
 for(let g=0;g<=5;g++){const p=lo-pad+(hi-lo+2*pad)*g/5,y=Y(p);x.beginPath();x.moveTo(L,y);x.lineTo(W-R,y);x.stroke();x.fillText(p.toFixed(0),W-R+6,y+4)}
 const line=(arr,col,w=1.4)=>{x.beginPath();x.strokeStyle=col;x.lineWidth=w;let on=0;arr.slice(view.s,view.s+view.n).forEach((v,i)=>{if(v==null){on=0;return}on?x.lineTo(X(i),Y(v)):x.moveTo(X(i),Y(v));on=1});x.stroke()};
 if(ov.BB){line(ind.bb.map(b=>b&&b[0]),'#4b5d78',1);line(ind.bb.map(b=>b&&b[2]),'#4b5d78',1)}
 if(ov.Levels)ind.lv.forEach(l=>{if(l.p<lo-pad||l.p>hi+pad)return;const y=Y(l.p);x.setLineDash([5,4]);x.strokeStyle=l.side==='S'?'#26c28166':'#ef535066';x.beginPath();x.moveTo(L,y);x.lineTo(W-R,y);x.stroke();x.setLineDash([]);x.fillStyle=l.side==='S'?'#26c281':'#ef5350';x.fillText(l.side+' '+l.p.toFixed(0),L+4,y-3)});
 const vm=Math.max(...V.map(k=>k.v));
 V.forEach((k,i)=>{const up=k.c>=k.o,col=up?'#26c281':'#ef5350';x.strokeStyle=col;x.fillStyle=col;x.lineWidth=1;
  x.beginPath();x.moveTo(X(i),Y(k.h));x.lineTo(X(i),Y(k.l));x.stroke();const t=Y(Math.max(k.o,k.c)),b=Y(Math.min(k.o,k.c));x.fillRect(X(i)-cw*.35,t,cw*.7,Math.max(1,b-t));
  x.globalAlpha=.45;x.fillRect(X(i)-cw*.35,vy+vh-k.v/vm*vh,cw*.7,k.v/vm*vh);x.globalAlpha=1});
 if(ov.EMA9)line(ind.e9,'#f0b429');if(ov.EMA20)line(ind.e20,'#5aa9ff');if(ov.EMA50)line(ind.e50,'#c084fc');if(ov.VWAP)line(ind.vw,'#e6e6e6',1.2);
 x.fillStyle='#7c8ba0';x.fillText('Volume',L,vy+10);x.fillText('RSI 14',L,ry-4);x.strokeStyle='#202c3b';
 [30,70].forEach(v=>{const y=ry+rh*(1-v/100);x.beginPath();x.moveTo(L,y);x.lineTo(W-R,y);x.stroke();x.fillText(v,W-R+6,y+4)});
 x.beginPath();x.strokeStyle='#5aa9ff';let on=0;ind.rsi.slice(view.s,view.s+view.n).forEach((v,i)=>{if(v==null){on=0;return}const y=ry+rh*(1-v/100);on?x.lineTo(X(i),y):x.moveTo(X(i),y);on=1});x.stroke();
 const tip=$('tip');if(mx!=null&&mx>=L&&mx<=W-R){const i=Math.min(V.length-1,Math.max(0,Math.floor((mx-L)/cw))),k=V[i];x.strokeStyle='#7c8ba0';x.setLineDash([3,3]);x.beginPath();x.moveTo(X(i),0);x.lineTo(X(i),H);x.stroke();x.setLineDash([]);
  tip.textContent=`${tsf(k.t)}  O ${k.o.toFixed(2)}  H ${k.h.toFixed(2)}  L ${k.l.toFixed(2)}  C ${k.c.toFixed(2)}  V ${k.v}`}else tip.textContent=`${tf} · DEMO/IMPORTED candles`}
function refresh(){compute();ui();draw()}
document.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;if(b.dataset.tf){tf=b.dataset.tf;view.n=80;refresh()}if(b.dataset.ov){ov[b.dataset.ov]^=1;ui();draw()}});
const cv=$('cv');let drag=null;
cv.addEventListener('wheel',e=>{e.preventDefault();const f=e.deltaY>0?1.15:.87;view.n=Math.round(Math.min(C.length,Math.max(20,view.n*f)));view.s=Math.min(Math.max(0,C.length-view.n),view.s);draw()},{passive:false});
cv.addEventListener('pointerdown',e=>{drag={x:e.clientX,s:view.s};cv.setPointerCapture(e.pointerId)});
cv.addEventListener('pointerup',()=>drag=null);cv.addEventListener('pointerleave',()=>{mx=null;draw()});
cv.addEventListener('pointermove',e=>{mx=e.clientX-cv.getBoundingClientRect().left;if(drag){const d=Math.round((drag.x-e.clientX)/(cv.clientWidth/view.n));view.s=Math.min(Math.max(0,C.length-view.n),Math.max(0,drag.s+d))}draw()});
addEventListener('resize',draw);
$('csv').addEventListener('change',async e=>{const f=e.target.files[0];if(!f)return;
 const rows=(await f.text()).split(/\r?\n/).map(l=>l.split(',')).map(a=>({t:Date.parse(a[0]),o:+a[1],h:+a[2],l:+a[3],c:+a[4],v:+a[5]||0})).filter(k=>[k.t,k.o,k.h,k.l,k.c].every(Number.isFinite)).sort((a,b)=>a.t-b.t);
 if(rows.length<50){alert('Need at least 50 valid 1-minute rows: timestamp,open,high,low,close,volume');return}
 raw=rows;$('badge').textContent='YOUR CSV DATA – '+f.name;$('badge').className='badge csv';view.n=80;refresh()});
if(typeof document!=='undefined')refresh();
</script></body></html>
