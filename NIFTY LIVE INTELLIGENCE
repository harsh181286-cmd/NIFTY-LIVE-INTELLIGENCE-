def main():
    if os.path.exists("nifty-live-intelligence"):
        print("Folder 'nifty-live-intelligence' already exists. Rename/delete it first."); return
    zipfile.ZipFile(io.BytesIO(base64.b64decode("".join(DATA.split())))).extractall(".")
    root = "nifty-live-intelligence"
    shutil.copy(f"{root}/backend/.env.example", f"{root}/backend/.env")
    shutil.copy(f"{root}/frontend/.env.example", f"{root}/frontend/.env")
    print("Project files created in ./" + root)
    if input("Install dependencies now? (needs internet, Python + Node) [y/N]: ").strip().lower() == "y":
        py = sys.executable
        subprocess.call([py, "-m", "pip", "install", "-r", f"{root}/backend/requirements.txt"])
        subprocess.call("npm install", shell=True, cwd=f"{root}/frontend")
    print("\nRun backend : cd nifty-live-intelligence/backend && uvicorn app.main:app --reload --port 8000")
    print("Run frontend: cd nifty-live-intelligence/frontend && npm run dev")
    print("Run tests   : cd nifty-live-intelligence/backend && pytest")

if __name__ == "__main__":
    main()
